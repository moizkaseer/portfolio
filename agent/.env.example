# Model (brief §1). LLM_PROVIDER=gemini (default) runs on Google's FREE tier:
# create a key at https://aistudio.google.com/apikey — no billing, no Anthropic key needed.
# Without a key for the chosen provider, /v1/chat answers 503 {"demo": true} and the
# site plays its scripted demo replay.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.5-flash-lite
# Tried in order on 429 / quota / overload / "model not available" (each has its own free quota).
# Filtered against the key's live model list. "none" disables fallbacks.
AGENT_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest
# AGENT_THINKING_LEVEL=          # optional for Gemini 3+: minimal | low | medium | high
# AGENT_LLM_TIMEOUT_MS=25000     # per model call
# GEMINI_FREE_TIER=true          # cost budget counts $0 on the free tier
# Only for LLM_PROVIDER=anthropic (paid): ANTHROPIC_API_KEY=, AGENT_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
AGENT_MAX_STEPS=6
AGENT_MAX_OUTPUT_TOKENS=500
AGENT_MAX_COST_USD=0.05
# AGENT_COST_INPUT_PER_MTOK=
# AGENT_COST_OUTPUT_PER_MTOK=
# AGENT_RATE_INFO=

# Guardrails & security (brief §5). Set AGENT_SHARED_SECRET in every real deployment —
# it must match the Next.js side's AGENT_SHARED_SECRET exactly.
AGENT_SHARED_SECRET=
AGENT_ALLOWED_ORIGINS=https://www.moizali.tech,https://moizali.tech
AGENT_MAX_INPUT_CHARS=500
AGENT_MAX_TURNS=6
AGENT_MAX_MESSAGES=40
AGENT_RATE_LIMIT_PER_HOUR=12
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Knowledge base (brief §3). CONTENT_DIR defaults to ../content (the repo's content/).
# CONTENT_DIR=
# AGENT_DATA_DIR=
# AGENT_INDEX_PATH=
GITHUB_TOKEN=
GITHUB_README_REPOS=
DATABASE_URL=
EMBEDDING_PROVIDER=
OPENAI_API_KEY=

# Tools (brief §4)
CALENDLY_TOKEN=
CALENDLY_EVENT_SLUG=30-min-intro-call
RESEND_API_KEY=
AGENT_FROM_EMAIL=hello@moizali.tech
AGENT_TO_EMAIL=moizkaseer@gmail.com
# LEADS_DB_PATH=

# Server
HOST=0.0.0.0
PORT=8000
