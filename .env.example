# Canonical site URL (SEO: canonical links, sitemap, OG images, JSON-LD). Without it, the site
# falls back to https://www.<domain from content/site.json>, then Vercel's production URL, then
# localhost. Set this explicitly if those ever disagree with the real public URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Contact form (Resend). Without these, dev logs the message; production answers 503.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"

# Rate limiting (Upstash Redis). Without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live agent (Phase 5). Without AGENT_MODEL + a key, the site plays the scripted "demo replay".
# AGENT_MODEL is "provider/model". Through the Vercel AI Gateway (default) use gateway ids,
# e.g. "anthropic/claude-sonnet-5.5" (current list: https://ai-gateway.vercel.sh/v1/models).
AGENT_MODEL=
AGENT_PROVIDER=gateway   # gateway | anthropic | openai
AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=     # when AGENT_PROVIDER=anthropic (model part = Anthropic's own id)
# OPENAI_API_KEY=        # when AGENT_PROVIDER=openai
