# Contact form (Resend). Without these, dev logs the message; production answers 503.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"

# Rate limiting (Upstash Redis). Without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
